# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Use gpt-5.5 only for an admin-only comparison deployment; otherwise use default.
EXPO_PUBLIC_AI_MODEL_PROFILE=default
# Keep off until both apps and Supabase CAPTCHA verification are configured.
# Only the Turnstile site key is public. Its secret belongs in Supabase only.
EXPO_PUBLIC_AUTH_CAPTCHA_ENABLED=false
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
